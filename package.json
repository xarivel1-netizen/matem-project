{
  "name": "matem-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @matem/web dev",
    "dev:server": "pnpm --filter @matem/server dev",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @matem/server seed",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
  }
}
